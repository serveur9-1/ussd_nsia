generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model anomalie {
  id_anomalie       Int      @id @default(autoincrement())
  msisdn            String   @db.VarChar(50)
  reference_init    String   @db.VarChar(255)
  new_reference     String   @db.VarChar(255)
  date_modification DateTime @db.Date
}

model bonus {
  id      Int    @id @default(autoincrement())
  montant String @db.VarChar(10)
  produit String @db.VarChar(10)
  niveau  Int
}

model commission {
  id               Int    @id @default(autoincrement())
  montant          String @db.VarChar(225)
  produit          String @db.VarChar(50)
  type_merchant    String @db.VarChar(2)
  type_transaction String @db.VarChar(25)
}

model factures {
  ID_FACTURE             Int    @id @default(autoincrement())
  REFERENCE              String @db.VarChar(255)
  AMOUNT                 String @db.VarChar(50)
  MSISDN                 String @db.VarChar(50)
  BILLMAP_TRANSACTION_ID String @db.VarChar(50)
  EWP_TRANSACTION_ID     String @db.VarChar(50)
  RESPONSE_CODE          String @db.VarChar(50)
  RESPONSE_MESSAGE       String @db.VarChar(500)
  Date_transaction       String @db.VarChar(15)
  prime                  String @db.VarChar(50)
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue], map: "jobs_queue_index")
}

model merchant {
  id            Int       @id @default(autoincrement())
  noms_prenoms  String    @db.VarChar(100)
  phoneNo       String    @db.VarChar(25)
  commission    String    @db.VarChar(255)
  id_equipe     Int
  type_merchant Int
  status        Int       @default(1)
  created_at    DateTime  @default(dbgenerated("('2019-08-29 00:00:00')")) @db.Timestamp(0)
  updated_at    DateTime  @default(dbgenerated("('2019-08-29 00:00:00')")) @db.Timestamp(0)
  deleted_at    DateTime? @db.Timestamp(0)
}

model merchant_transactions {
  id                    Int    @id @default(autoincrement())
  id_client             Int
  id_merchant           Int
  reference_transaction String @db.VarChar(255)
  etat_transaction      String @db.VarChar(10)
  montant_transaction   String @db.VarChar(255)
  date_transaction      String @db.VarChar(10)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model migrations {
  id        Int    @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int

  @@ignore
}

model naf_beneficiaires {
  ID_BENEFICIAIRE        Int    @id @default(autoincrement())
  NOM_BENEFICIAIRE       String @db.VarChar(50)
  TELEPHONE_BENEFICIAIRE String @db.VarChar(50)
  TYPE_BENEFICIAIRE      String @db.VarChar(50)
}

model naf_bonus {
  id                      Int @id @default(autoincrement())
  id_merchant_transaction Int
  id_merchant             Int
  montant                 Int
}

model naf_clients {
  ID_CLIENT  Int    @id @default(autoincrement())
  MSISDN     String @db.VarChar(50)
  GENDER     String @db.VarChar(50)
  BIRTH_DATE String @db.VarChar(15)
  TITLE      String @db.VarChar(50)
  FIRST_NAME String @db.VarChar(50)
  LAST_NAME  String @db.VarChar(50)
}

model naf_paiements {
  ID_PAIEMENT        Int      @id @default(autoincrement())
  ID_SOUSCRIPTION    Int
  MONTANT_PAIEMENT   BigInt
  DATE_PAIEMENT      DateTime @db.Date
  REFERENCE_PAIEMENT String   @db.VarChar(100)
  ETAT_PAIEMENT      String   @db.VarChar(50)
  MSISDN             String?  @db.VarChar(100)
}

model naf_resiliation {
  id               Int    @id @default(autoincrement())
  id_souscription  String @db.VarChar(11)
  msisdn           String @db.VarChar(20)
  date_resiliation String @db.VarChar(10)
}

model naf_retraits {
  ID_RETRAIT        Int      @id @default(autoincrement())
  ID_SOUSCRIPTION   Int
  MONTANT_RETRAIT   BigInt
  DATE_RETRAIT      DateTime @db.Date
  REFERENCE_RETRAIT String   @db.VarChar(50)
}

model naf_souscriptions {
  ID_SOUSCRIPTION        Int      @id @default(autoincrement())
  ID_CLIENT              Int
  ID_BENEFICIAIRE        Int
  MONTANT_SOUSCRIPTION   BigInt
  DATE_SOUSCRIPTION      DateTime @db.Date
  ETAT_SOUSCRIPTION      String   @db.VarChar(50)
  REFERENCE_SOUSCRIPTION String   @db.VarChar(100)
  PROCHAIN_PAIEMENT      DateTime @db.Date
  NUMERO_POLICE          String?  @db.VarChar(50)
  MSISDN                 String?  @db.VarChar(100)
}

model nep_beneficiaires {
  ID_BENEFICIAIRE        Int    @id @default(autoincrement())
  NOM_BENEFICIAIRE       String @db.VarChar(50)
  TELEPHONE_BENEFICIAIRE String @db.VarChar(50)
  TYPE_BENEFICIAIRE      String @db.VarChar(50)
}

model nep_bonus {
  id                      Int @id @default(autoincrement())
  id_merchant_transaction Int
  id_merchant             Int
  montant                 Int
}

model nep_clients {
  ID_CLIENT  Int    @id @default(autoincrement())
  MSISDN     String @db.VarChar(50)
  GENDER     String @db.VarChar(50)
  BIRTH_DATE String @db.VarChar(15)
  TITLE      String @db.VarChar(50)
  FIRST_NAME String @db.VarChar(50)
  LAST_NAME  String @db.VarChar(50)
}

model nep_paiements {
  ID_PAIEMENT        Int      @id @default(autoincrement())
  ID_SOUSCRIPTION    Int
  MONTANT_PAIEMENT   BigInt
  DATE_PAIEMENT      DateTime @db.Date
  REFERENCE_PAIEMENT String   @db.VarChar(255)
  ETAT_PAIEMENT      String   @db.VarChar(50)
  prime              String   @db.VarChar(50)
  MSISDN             String?  @db.VarChar(100)
}

model nep_retraits {
  ID_RETRAIT        Int      @id @default(autoincrement())
  ID_SOUSCRIPTION   Int
  MONTANT_RETRAIT   BigInt
  DATE_RETRAIT      DateTime @db.Date
  REFERENCE_RETRAIT String   @db.VarChar(50)
  TYPE_RETRAIT      String   @db.VarChar(255)
  MSISDN            String?  @db.VarChar(100)
}

model nep_souscriptions {
  ID_SOUSCRIPTION        Int      @id @default(autoincrement())
  ID_CLIENT              Int
  ID_BENEFICIAIRE        Int
  MONTANT_SOUSCRIPTION   BigInt
  DATE_SOUSCRIPTION      DateTime @db.Date
  ETAT_SOUSCRIPTION      String   @db.VarChar(50)
  REFERENCE_SOUSCRIPTION String   @db.VarChar(100)
  PROCHAIN_PAIEMENT      DateTime @db.Date
  NUMERO_POLICE          String?  @db.VarChar(50)
  MSISDN                 String?  @db.VarChar(100)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model nsia_autres_produits {
  ID_SOUSCRIPTION Int
  NUMERO_POLICE   String @db.VarChar(50)
  MONTANT         String @db.VarChar(50)
  NOM_PRODUIT     String @db.VarChar(50)
  PERIODE_FACTURE String @db.VarChar(50)
  ETAT_PAIEMENT   String @db.VarChar(50)

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model password_reset_tokens {
  email      String    @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model password_resets {
  email      String    @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)

  @@ignore
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt    @db.UnsignedBigInt
  name           String    @db.VarChar(255)
  token          String    @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
}

model type_merchant {
  id      Int    @id @default(autoincrement())
  libelle String @db.VarChar(25)
}

model upload {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  filename   String?
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model users {
  id                Int       @id @default(autoincrement()) @db.UnsignedInt
  name              String    @db.VarChar(255)
  email             String    @db.VarChar(255)
  email_verified_at DateTime? @db.Timestamp(0)
  password          String    @db.VarChar(255)
  user_group        Int
  role_level        Int
  last_login_date   DateTime  @db.Date
  activity_flag     Int
  postname          String    @db.VarChar(255)
  code              String    @db.VarChar(255)
  remember_token    String?   @db.VarChar(100)
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)
  deleted_at        DateTime? @db.Timestamp(0)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model auto_debit_schedule {
  id              BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  product         String                     @db.VarChar(50)
  subscription_id BigInt                     @db.UnsignedBigInt
  plan            String                     @db.LongText
  next_debit_date DateTime                   @db.DateTime(0)
  retry_count     Int                        @default(0) @db.UnsignedTinyInt
  status          auto_debit_schedule_status @default(PENDING)
  notified        Boolean?
  processing      Boolean?
  created_at      DateTime                   @default(now()) @db.Timestamp(0)
  updated_at      DateTime                   @default(now()) @db.Timestamp(0)
  deleted_at      DateTime?                  @db.Timestamp(0)

  @@index([next_debit_date], map: "idx_next_debit_date")
  @@index([product], map: "idx_product")
}

enum auto_debit_schedule_status {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}
